.DS_Store
xcuserdata/
*.xcodeproj
DerivedData/
.build/
.swiftpm/

# 內部文件（交接、筆記）只留本機
docs/
.claude/

# Build artifacts 打包產物
dist/
.b1-work/
.b3-work/
.b4-work/
.b6-work/
.a-work/
.d-work/

# xcodebuild clean 會把中繼產物倒進 repo 根目錄
*.o
*.d
*.dia
*.swiftdeps
*.swiftconstvalues

# xcodebuild -target 直接建置時的 SYMROOT（package.sh 走 dist/）
build/

# repo 在 iCloud 同步的 ~/Documents 裡：build 快取若被同步，xcodebuild 開專案時會卡死在
# NSFileCoordinator（2026-09-19 查明，.build 長到 36 GB）。實體放在
# ~/Library/Caches/DevBuild/（iCloud 不同步；2026-10-05 確認 iCloud 已不理會 *.nosync，會加回 FinderInfo 讓 codesign 失敗），
# 原名是指過去的 symlink——`build/` 這種結尾帶斜線的規則對 symlink 無效，所以另列不帶斜線的。
# clone 或整個刪掉之後要重建：mkdir -p ~/Library/Caches/DevBuild/Chorus_X && ln -s ~/Library/Caches/DevBuild/Chorus_X X
# （Packages/ChorusCore/.build 指向 ~/Library/Caches/ChorusWorktrees/main-core.build）
*.nosync
/build
/DerivedData
/Packages/ChorusCore/.build
