{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus needs to capture system audio to provide independent per-app volume and EQ. Audio is processed only on this Mac and is never sent anywhere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 需要捕获系统音频，才能提供各 App 独立音量与均衡器。音频仅在本机处理，不会传送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 需要擷取系統音訊，才能提供各 App 獨立音量與等化器。音訊只在本機處理，不會傳送到任何地方。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus looks for your other Macs on the local network to sync brightness and volume."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 会在局域网络中查找你的其他 Mac，以同步亮度和音量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 會在區域網路上尋找你的其他 Mac，以同步亮度與音量。"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus uses your location only to calculate sunrise and sunset times, as an ambient light estimate when no ambient light sensor is available. Your location never leaves this Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 只用你的所在地计算日出日落时间，作为没有光线传感器时的环境光估计。位置不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 只用你的所在地計算日出日落時間，作為沒有光線感測器時的環境光估計。位置不會離開這台 Mac。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus uses your location only to calculate sunrise and sunset times, as an ambient light estimate when no ambient light sensor is available. Your location never leaves this Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 只用你的所在地计算日出日落时间，作为没有光线传感器时的环境光估计。位置不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 只用你的所在地計算日出日落時間，作為沒有光線感測器時的環境光估計。位置不會離開這台 Mac。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
