          }
        }
      }
    },
    "此裝置的音訊完全走原生路徑：不套用 EQ、平衡、效果鏈與軟體音量。既有設定會保留，取消排除即恢復。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio from this device uses the native path only: EQ, balance, effect chain, and software volume are not applied. Existing settings are retained and restored when it is no longer excluded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
