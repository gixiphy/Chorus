    "App 內沒有附 driver（開發版）。請在專案目錄執行 scripts/build-audio-driver.sh 後 sudo scripts/install-audio-driver.sh。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does not include a driver (development build). In the project directory, run scripts/build-audio-driver.sh, then sudo scripts/install-audio-driver.sh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 内未附带 driver（开发版）。请在项目目录运行 scripts/build-audio-driver.sh 后 sudo scripts/install-audio-driver.sh。"
          }
        }
      }
    },
    "App 內附的驅動比已安裝的新；更新會重啟音訊服務。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The driver bundled with the app is newer than the installed one; updating restarts audio services."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 内附带的驱动比已安装的新；更新会重启音频服务。"
          }
        }
      }
    },
    "App 層的 EQ 與 AU 效果鏈——只套這個 App，與裝置層是不同責任的兩次" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-level EQ and AU effect chain - applied only to this app, separate from device-level processing"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 层的 EQ 与 AU 效果链——仅应用于此 App，与设备层是不同职责的两次"
          }
        }
      }
    },
