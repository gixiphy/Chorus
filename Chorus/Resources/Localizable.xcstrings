    "Chorus" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus"
          }
        }
      }
    },
    "Chorus 內建繁體中文、简体中文與英文。其他語言可以交給本機的 AI CLI（設定 → AI 引擎裡選的那個）翻譯全部介面文字；翻好的檔只存在這台 Mac，隨時可以切回內建語言。這是機器翻譯，翻不好的字串會退回英文。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus includes Traditional Chinese, Simplified Chinese, and English. You can use this Mac's AI CLI (the one selected in Settings → AI Engine) to translate all UI text into other languages; translated files stay on this Mac, and you can switch back to a built-in language at any time. This is machine translation. Strings that cannot be translated fall back to English."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 内置繁体中文、简体中文与英文。其他语言可以交给本机的 AI CLI（设置 → AI 引擎里选的那个）翻译全部界面文字；翻好的文件只存在这台 Mac，随时可以切回内置语言。这是机器翻译，翻不好的字符串会退回英文。"
          }
        }
      }
    },
    "Chorus 內建繁體中文、简体中文與英文，跟隨系統或在上面直接指定。其他語言可以交給本機的 AI CLI（設定 → AI 引擎裡選的那個）翻譯全部介面文字；翻好的檔只存在這台 Mac，隨時可以切回內建語言。這是機器翻譯，翻不好或還沒翻的字串會顯示英文。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus includes Traditional Chinese, Simplified Chinese, and English, which can follow the system or be set directly above. For other languages, an AI CLI on this Mac (the one selected in Settings → AI Engine) can translate the entire interface; the translated file stays on this Mac only, and you can switch back to a built-in language at any time. This is machine translation, so poorly translated or untranslated strings will appear in English."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 内置繁体中文、简体中文与英文，跟随系统或在上面直接指定。其他语言可以交给本机的 AI CLI（设置 → AI 引擎里选的那个）翻译全部界面文字；翻好的文件只存在这台 Mac，随时可以切回内置语言。这是机器翻译，翻不好或还没翻的字符串会显示英文。"
          }
        }
      }
    },
    "Chorus 完全不碰這個 App 的音訊——per-app 調整與裝置等化／軟體音量都略過它" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus does not touch this app's audio - it skips per-app adjustments, device EQ, and software volume"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 完全不处理此 App 的音频——逐 App 调整与设备均衡／软件音量都会跳过它"
          }
        }
      }
    },
    "Chorus 完全不碰這個 App：不建 per-app tap，裝置等化與軟體音量也略過它（調整保留，適合 DAW、遊戲、視訊會議）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus does not touch this app: it creates no per-app tap, and device EQ and software volume also skip it (adjustments are retained; suited to DAWs, games, and video calls)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorus 完全不处理此 App：不创建逐 App tap，设备均衡与软件音量也会跳过它（调整会保留，适合 DAW、游戏、视频会议）"
          }
        }
      }
    },
    "DDC" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
