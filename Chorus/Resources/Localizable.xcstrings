    "DDC 硬體鏡射（不損音質）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC hardware mirroring (no audio quality loss)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC 硬件镜像（不损音质）"
          }
        }
      }
    },
    "DDC 診斷" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC Diagnostics"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
